# KindleRanker BR — Variáveis de ambiente
# Copie para .env e preencha os valores reais
# Para systemd: cole cada linha como Environment=KEY=VALUE no .service

# ── Banco de dados ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kindleranker
DB_USER=postgres
DB_PASS=

# ── FastAPI ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://app.kindleranker.com.br,http://localhost:3000

# ── Claude AI ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Resend (e-mails transacionais) ─────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@kindleranker.com.br

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Obter em: painel.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...

# Obter executando: python stripe_setup.py
# ou em: painel.stripe.com → Developers → Webhooks → seu endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs gerados pelo stripe_setup.py (ou stripe_ids.env)
STRIPE_PRICE_MENSAL=price_...
STRIPE_PRICE_ANUAL=price_...

# ── Dashboard (URL pública) ─────────────────────────────────────────────────────
DASHBOARD_URL=https://app.kindleranker.com.br

# ── n8n ────────────────────────────────────────────────────────────────────────
# Configurado internamente no n8n — não precisa estar aqui
# N8N_WEBHOOK_URL=https://n8n.kindleranker.com.br/webhook/...
